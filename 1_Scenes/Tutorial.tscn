[node name="DialogueArea" parent="Quests/GardenStunGuard/OldTanukiNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("6_3ktbq")]
dialogueText = Array[String](["Ok young-un, now for an harder challenge...", "See that guard? It will try to capture you, if you are captured you are kicked out of the room, and your progress will be reset.", "To avoid that, transform and hide, if you have done your training properly it's quite easy.", "See that? Obtain that transformation, and once transformed you will see a shiny path where you can safely hide.", "Try to avoid the guard and get to the hammer I stole from the mansion, it's...", "Right there. Once you reach this point, save the axe as your transformation, transform into it...", "...AND HIT THAT GUARD!", "I'll explain more once you have done all of this. Get working, young-un.", "Yessir!"])
characterTalking = Array[int]([2, 2, 2, 2, 2, 2, 2, 2, 0])
characterEmotion = Array[int]([0, 0, 0, 0, 0, 0, 0, 0, 0])
cameraFocuses = [NodePath(".."), NodePath("../../../../Enemy/Guard1"), NodePath(".."), NodePath("../../../../TransformationObjects/Vase2"), NodePath(".."), null, NodePath("../../../../Enemy/Guard1"), NodePath(".."), null]
isOnInteraction = true


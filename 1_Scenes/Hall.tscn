[node name="SadGuardFirstDialogue" parent="Quests/HallStopTheDoor/SadGuardNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("10_oxkx2")]
position = Vector2(0, -48)
dialogueText = Array[String](["Oh no a guard! I have to hide, quick!", "It's pointless...", "Huh?", "It's pointless... pointless...", "...you okay?", "...an intruder... it's still pointless... it's been days...", "Days of what?", "I haven't slept... in days... because of this door...", "The bedrooms are on the right of this room, my bed is close to this wall... this door... has been possessed.", "It keeps. Making. NOISE!", "I CAN'T SLEEP!", "I think a door stop would be able to crush those teeth... but... no energy to find it...", "Hehehe... thanks for the juicy info, insomniac guard! I see a key behind this door: I do this for you and you stay silent about this, deal?", "Deal... I can't take this anymore, please..."])
characterTalking = Array[int]([0, 2, 0, 2, 0, 2, 0, 2, 2, 2, 2, 2, 0, 2])
cameraFocuses = [null, NodePath(".."), null, NodePath(".."), null, NodePath(".."), null, NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), null, NodePath("..")]
isOnInteraction = true


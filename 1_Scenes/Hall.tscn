position = Vector2(0, -48)
dialogueText = Array[String](["Thank you... my agony... is gone...", "Happy to help, hehe... listen, can you give me directions? I see 3 doors there, where do they lead?", "Right... bedrooms, bottom... Kitchen, left... Dojo...", "There's a strong Hyottoko man in the dojo, watch out...", "I will, thank you!"])
characterTalking = Array[int]([2, 0, 2, 2, 0])

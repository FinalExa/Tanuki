[node name="EntranceNPCGetBackBellDialogue" parent="Quests/HallFixEntrance/EntranceNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("10_oxkx2")]
dialogueText = Array[String](["Thanks for cleaning the carpet.", "No problem! What's next?", "Those guards... they removed my physical body from here, it's a bell like me. Can you get it back here?", "I got ya.", "Should be in one of the rooms around here, they just trashed it like it was nothing..."])
characterTalking = Array[int]([2, 0, 2, 0, 2])
cameraFocuses = [NodePath(".."), null, NodePath(".."), null, NodePath("..")]

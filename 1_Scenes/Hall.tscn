[node name="EntranceNPCColorTheBellDialogue" parent="Quests/HallFixEntrance/EntranceNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("10_oxkx2")]
dialogueText = Array[String](["So... that should be everything yes?", "Actually... I have a last request for you.", "*sigh* Go on.", "My poor body... has lost all of it's color, it was of a proud yellow! Are you able to restore it in any way?", "I'll check.", "Thank you! I'll give you the key if you manage to do it."])

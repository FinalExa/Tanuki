[node name="EntranceNPCCleanDialogue" parent="Quests/HallFixEntrance/EntranceNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("10_oxkx2")]
dialogueText = Array[String](["*sniff* *sob* *sniff*", "Huh, why are you crying?", "*sniff* oh... a guest... wait...", "Hm?", "You're not one of those guards! Maybe you can help me...?", "I'm kinda in a hurry here... do you know anything about keys? I'll help you in that case.", "Keys? Yes. I am tasked to protect one! But... I'm willing to ignore that if you help me.", "Go on, I'm all ears.", "*sniff* Thank you.", "*ahem* THOSE BUFOONS WHO MANAGE THINGS HERE HAVE MADE A MESS OF THE ENTRANCE, THE ENTRANCE I AM TASKED TO LOOK OUT FOR!", "See the carpet? No? Well, it's because of the brown goop.", "Touching it will deplete your energies... it won't harm you though, don't worry.", "Find something to clean it, then speak to me, I need other things to clear the entrance. I will also open the other doors here once you're done with it, as thanks.", "Okay. Will do."])
characterTalking = Array[int]([2, 0, 2, 0, 2, 0, 2, 0, 2, 2, 2, 2, 2, 0])
cameraFocuses = [NodePath(".."), null, NodePath(".."), null, NodePath(".."), null, NodePath(".."), null, NodePath(".."), NodePath(".."), NodePath("../../DirtyFloor"), NodePath("../../DirtyFloor"), NodePath(".."), null]
isOnInteraction = true


[node name="PasswordNPCBaseDialogue" parent="Quests/HallGetPassword/PasswordNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("10_oxkx2")]
dialogueText = Array[String](["Hey! I want to...", "...go through that wall!", "...if you want that, give me the password, please.", "A password? No other way?", "No.", "Hm... any help at least in finding that?", "No.", "Please?", "Okay. But only because I don't like the new guards causing a ruckus here, and you seem like an intruder to them. It's gonna be fun.", "See the brush close to me? Take it...", "...find the color yokais, they'll give you their magical color...", "...and write the password on that table.", "I also see that you have a leaf with you, convenient. You can use it to reset the password progress if it's wrong.", "The password hints should be around here, be wary that it's updated constantly. If you get captured it will change by the time you get back in.", "I got it, thanks!", "Good luck in finding it, even I don't know it. I am just here for information about it.", "But if you open it, I'll give you my key, to spite those guards.", "Ohhh! Thanks! I really need keys!", "I know."])
characterTalking = Array[int]([0, 0, 2, 0, 2, 0, 2, 0, 2, 2, 2, 2, 2, 2, 0, 2, 2, 0, 2])
cameraFocuses = [null, NodePath("../../BlockerWalls"), NodePath(".."), null, NodePath(".."), null, NodePath(".."), null, NodePath(".."), NodePath("../../../../Transformations/Brush"), NodePath("../../../../NPCs/ColorYokais/ColorYokai"), NodePath("../../PasswordTable"), NodePath(".."), NodePath(".."), null, NodePath(".."), NodePath(".."), null, NodePath("..")]
isOnInteraction = true


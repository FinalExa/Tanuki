[node name="DialogueArea4" parent="Quests/GardenStunGuard/NerdTanukiNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("6_3ktbq")]
dialogueText = Array[String](["Hello, Daichi.", "Oh heya! Master told me that I could review with you!", "Indeed. I'll explain the transformation again.", "There are certain objects around which you can transform into, they have a small blue flame inside it.", "Get close to those objects and press SHIFT, you will save that object as a transformation. Then press E to transform into the object.", "Once transformed you have a certain amount of energy, once the energy is exhausted, you lose the transformation and have to get it back.", "You cannot save the same item to replenish energy, it won't work because that item already was manifested with your transformation magic, you can only replace it with new items.", "Some transformation have attacks, which are used via LEFT CLICK while transformed. Attacking will consume a flat amount of energy, after the attack is done.", "Certain transformations drain more over time or while attacking.", "Is that all?", "Yes, if you want to listen to this again, I am here.", "Thank you!"])
characterTalking = Array[int]([2, 0, 2, 2, 2, 2, 2, 2, 2, 0, 2, 0])
cameraFocuses = [NodePath(".."), null, NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), null, NodePath(".."), null]
isOnInteraction = true


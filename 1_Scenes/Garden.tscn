[sub_resource type="Resource" id="Resource_dpac4"]
script = ExtResource("20_uxh8o")
dialogueText = "I will give it to you... if you feed me!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_irkqr"]
script = ExtResource("20_uxh8o")
dialogueText = "Bring me an acorn from the tree there! Then I will give you the key!"
characterTalking = 2
cameraFocus = NodePath("../../AcornTree")

[sub_resource type="Resource" id="Resource_t78u2"]
script = ExtResource("20_uxh8o")
dialogueText = "Alright, will do. Just be sure to give me the key afterwards!"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_d7pmj"]

script = ExtResource("20_uxh8o")
dialogueText = "Young-un, now for an harder challenge..."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC")

[sub_resource type="Resource" id="Resource_ce1p6"]
script = ExtResource("20_uxh8o")
dialogueText = "See that guard? It will try to capture you, if you are captured you are kicked out of the room, and your progress will be reset."
characterTalking = 2
cameraFocus = NodePath("../../../Enemy/Guard1")

[sub_resource type="Resource" id="Resource_85fgc"]
script = ExtResource("20_uxh8o")
dialogueText = "To avoid that, transform and hide, if you have done your training properly it's quite easy."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC")

[sub_resource type="Resource" id="Resource_cb1br"]
script = ExtResource("20_uxh8o")
dialogueText = "See that? Obtain that transformation, and once transformed you will see a shiny path where you can safely hide. Just remember to not move while transformed, or the guard will know that something is amiss and will start to get suspicious."
characterTalking = 2
cameraFocus = NodePath("../../../TransformationObjects/GardenFlower4")

[sub_resource type="Resource" id="Resource_p5pac"]
script = ExtResource("20_uxh8o")
dialogueText = "Try to avoid the guard and get to the axe I stole from the mansion, it's..."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC")

[sub_resource type="Resource" id="Resource_871ga"]
script = ExtResource("20_uxh8o")
dialogueText = "Right there. Once you reach this point, save the axe as your transformation, transform into it..."
characterTalking = 2
cameraFocus = NodePath("../Axe")

[sub_resource type="Resource" id="Resource_7p8gd"]
script = ExtResource("20_uxh8o")
dialogueText = "...AND HIT THAT GUARD!"
characterTalking = 2
cameraFocus = NodePath("../../../Enemy/Guard1")

[sub_resource type="Resource" id="Resource_pbruu"]
script = ExtResource("20_uxh8o")
dialogueText = "I'll explain more once you have done all of this. Get working, young-un."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC")

[sub_resource type="Resource" id="Resource_1fdps"]
script = ExtResource("20_uxh8o")
dialogueText = "Yessir!"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="RectangleShape2D" id="RectangleShape2D_ns61c"]
size = Vector2(512, 512)

[sub_resource type="Resource" id="Resource_nfncx"]
script = ExtResource("20_uxh8o")
dialogueText = "QUICK YOUNG-UN, GRAB THAT KEY!"
characterTalking = 2
cameraFocus = NodePath("../../../Keys/UnlockKey1")

[sub_resource type="Resource" id="Resource_ko5jo"]
script = ExtResource("20_uxh8o")
dialogueText = "GET IT AND COME HERE!"
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC2")

[sub_resource type="CircleShape2D" id="CircleShape2D_hf5vy"]

[sub_resource type="Resource" id="Resource_ptejn"]
script = ExtResource("20_uxh8o")
dialogueText = "Nice job young-un, you got a key!"
characterTalking = 0
cameraFocus = NodePath("../OldTanukiNPC2")

[sub_resource type="Resource" id="Resource_i1lip"]
script = ExtResource("20_uxh8o")
dialogueText = "What's that for, master?"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_jribg"]
script = ExtResource("20_uxh8o")
dialogueText = "You see, young-un, to enter the mansion you will need to collect 3 keys, and that's one of them."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC2")

[sub_resource type="Resource" id="Resource_nll35"]
script = ExtResource("20_uxh8o")
dialogueText = "Sooo... two more to go!"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_jcs31"]
script = ExtResource("20_uxh8o")
dialogueText = "Indeed, you have completed the review of your training, use what you learned to get the other two keys."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC2")

[sub_resource type="Resource" id="Resource_7fh2e"]
script = ExtResource("20_uxh8o")
dialogueText = "Also, from what I know, inside the mansion is full of keys to find to proceed, so view this as a proper training area before venturing inside."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC2")

[sub_resource type="Resource" id="Resource_ggg1h"]
script = ExtResource("20_uxh8o")
dialogueText = "I am going to impress you master!"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_0h2mw"]
script = ExtResource("20_uxh8o")
dialogueText = "Well, good luck Daichi. If you want to review your skills, I've asked some other Tanuki to explain them to you again. They are just in the area before this one."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC2")

[sub_resource type="Resource" id="Resource_u6l0k"]
script = ExtResource("20_uxh8o")
dialogueText = "I shall be going now, good luck with your quest Daichi. This axe right here is the key to proceed onwards."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC2")

[sub_resource type="Resource" id="Resource_hy5ru"]
script = ExtResource("20_uxh8o")
dialogueText = "Thanks for everything, master!"

[sub_resource type="Resource" id="Resource_g8xag"]
script = ExtResource("20_uxh8o")
dialogueText = "Hello, Daichi."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_af6k2"]
script = ExtResource("20_uxh8o")
dialogueText = "Oh heya! Master told me that I could review with you!"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_1w7y3"]
script = ExtResource("20_uxh8o")
dialogueText = "Indeed. I'll explain the transformation again."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_q8n8q"]
script = ExtResource("20_uxh8o")
dialogueText = "There are certain objects around which you can transform into, they have a small blue flame inside it."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_5p2cd"]
script = ExtResource("20_uxh8o")
dialogueText = "Get close to those objects and press SHIFT, you will save that object as a transformation. Then press E to transform into the object."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_ol2df"]
script = ExtResource("20_uxh8o")
dialogueText = "Once transformed you have a certain amount of energy, once the energy is exhausted, you lose the transformation and have to get it back."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_4rvgi"]
script = ExtResource("20_uxh8o")
dialogueText = "You cannot save the same item to replenish energy, it won't work because that item already was manifested with your transformation magic, you can only replace it with new items."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_66cnq"]
script = ExtResource("20_uxh8o")
dialogueText = "Some transformation have attacks, which are used via LEFT CLICK while transformed. Attacking will consume a flat amount of energy, after the attack is done."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_y8t3p"]
script = ExtResource("20_uxh8o")
dialogueText = "Certain transformations drain more over time or while attacking."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_4bw61"]
script = ExtResource("20_uxh8o")
dialogueText = "Is that all?"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_aaicd"]
script = ExtResource("20_uxh8o")
dialogueText = "Yes, if you want to listen to this again, I am here."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_hq8ts"]
script = ExtResource("20_uxh8o")
dialogueText = "Thank you!"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="CircleShape2D" id="CircleShape2D_4a443"]
radius = 128.0

[sub_resource type="Resource" id="Resource_d3ph2"]
script = ExtResource("20_uxh8o")
dialogueText = "YOOOO! IT'S MY LITTLE BRO!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_onsue"]
script = ExtResource("20_uxh8o")
dialogueText = "Heya, \"big bro\"!"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_0i1lv"]
script = ExtResource("20_uxh8o")
dialogueText = "WASSUP! ARE YOU HERE FOR THE SUMMARY TO FACE OFF GUARDS?! I AM YOUR MAN THEN!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_5sn2u"]
script = ExtResource("20_uxh8o")
dialogueText = "WELL, I AM GONNA BE BRIEF WITH YA BRO."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_attwx"]
script = ExtResource("20_uxh8o")
dialogueText = "FIND A TRANSFORMATION THAT YOU FEEL LIKE YOU CAN SMACK GUARDS WITH, AND HIT THEM!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_ch2yd"]
script = ExtResource("20_uxh8o")
dialogueText = "THEY WILL BE STUNNED FOR SOME TIME!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_7tfer"]
script = ExtResource("20_uxh8o")
dialogueText = "WHILE IN THE HEAT OF THE MOMENT, YOU MIGHT LOSE YOUR TRANSFORMATION! WORRY NOT!!! JUST FIND ANY CLOSE OBJECT, AND TRY TO HIDE AWAY WITH HIT, JUST DON'T BE SEEN MOVING!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_gwg8b"]
script = ExtResource("20_uxh8o")
dialogueText = "IF THEY SEE YOU WHILE MOVING THEY'LL KNOW SOMETHING IS WRONG, ALSO! TRY TO STAY ON THE STARRY PATH, IT MEANS IT'S THE RIGHT THING TO HIDE THERE!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_2q7g8"]
script = ExtResource("20_uxh8o")
dialogueText = "IF YOU HIDE AWAY FROM THE STARRY PATH ON THE GROUND, THEY WILL ALSO KNOW SOMETHING IS AMISS!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_pig38"]
script = ExtResource("20_uxh8o")
dialogueText = "THAT WAS EVERYTHING, GOOD LUCK LITTLE BRO!"
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_efm2g"]
script = ExtResource("20_uxh8o")
dialogueText = "Thanks, \"big bro\"..."
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_eas4v"]
script = ExtResource("20_uxh8o")
dialogueText = "..."
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_yk334"]
script = ExtResource("20_uxh8o")
dialogueText = "...my poor ears."
characterTalking = 0

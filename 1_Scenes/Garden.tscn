dialogueText = "You'll also lose this transformation, it will make moving around here too easy..."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC")

[sub_resource type="Resource" id="Resource_ggtur"]
script = ExtResource("20_uxh8o")
dialogueText = "Why can't I have it easy, master?"
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_71jg1"]
script = ExtResource("20_uxh8o")
dialogueText = "Because... if you can't enter the mansion on your own and have to rely on my help, you'll get captured A LOT."
characterTalking = 2
cameraFocus = NodePath("../OldTanukiNPC")

[sub_resource type="Resource" id="Resource_dsfjl"]
script = ExtResource("20_uxh8o")
dialogueText = "Ohhh! I getcha."
characterTalking = 0
cameraFocus = NodePath("")

[sub_resource type="Resource" id="Resource_c616b"]

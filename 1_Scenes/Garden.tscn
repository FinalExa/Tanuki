[sub_resource type="Resource" id="Resource_ig2hp"]
script = ExtResource("20_uxh8o")
dialogueText = "Yes, I see that you need to deliver that acorn, young-un. So I'm here for a last lesson."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_kquus"]
script = ExtResource("20_uxh8o")
dialogueText = "You will have to transport certain objects; you can't transform into everything."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_ulrm8"]
script = ExtResource("20_uxh8o")
dialogueText = "While you're transporting an object, if you transform or attack with your leaf you'll drop it in the current spot."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_lr4wt"]
script = ExtResource("20_uxh8o")
dialogueText = "Also watch out for the water there, you'll lose it and have to go all the way back here to get it back."
characterTalking = 2
cameraFocus = NodePath("..")

[sub_resource type="Resource" id="Resource_sgxn0"]

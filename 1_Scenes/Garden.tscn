[node name="DialogueArea4" parent="Quests/GardenStunGuard/CoolTanukiNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("6_3ktbq")]
dialogueText = Array[String](["YOOOO! IT'S MY LITTLE BRO!", "Heya, \"big bro\"!", "WASSUP! ARE YOU HERE FOR THE SUMMARY TO FACE OFF GUARDS?! I AM YOUR MAN THEN!", "WELL, I AM GONNA BE BRIEF WITH YA BRO.", "FIND A TRANSFORMATION THAT YOU FEEL LIKE YOU CAN SMACK GUARDS WITH, AND HIT THEM!", "THEY WILL BE STUNNED FOR SOME TIME!", "WHILE IN THE HEAT OF THE MOMENT, YOU MIGHT LOSE YOUR TRANSFORMATION! WORRY NOT!!! JUST FIND ANY CLOSE OBJECT, AND TRY TO HIDE AWAY WITH HIT, JUST DON'T BE SEEN MOVING!", "IF THEY SEE YOU WHILE MOVING THEY'LL KNOW SOMETHING IS WRONG, ALSO! TRY TO STAY ON THE STARRY PATH, IT MEANS IT'S THE RIGHT THING TO HIDE THERE!", "IF YOU HIDE AWAY FROM THE STARRY PATH ON THE GROUND, THEY WILL ALSO KNOW SOMETHING IS AMISS!", "THAT WAS EVERYTHING, GOOD LUCK LITTLE BRO!", "Thanks, \"big bro\"...", "...", "...my poor ears."])
characterTalking = Array[int]([2, 0, 2, 2, 2, 2, 2, 2, 2, 2, 0, 0, 0])
cameraFocuses = [NodePath(".."), null, NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), NodePath(".."), null, null, null]
isOnInteraction = true


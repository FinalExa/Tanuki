[node name="DialogueArea" parent="Quests/GardenLowerTheBridge/OldTanukiNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("6_3ktbq")]
dialogueText = Array[String](["Next up young-un, do you remember your leafmanship training?", "Yes, master!", "Now that your senses have been honed, you should be able to see when you can interact with something with your leaf.", "Like here, can you see the windy aura in that area?", "Yes, I can see it master.", "It means that when you attack it with your leaf, something will happen, try it.", "Ohoh! Interesting.", "Remember that to attack with your leaf you cannot be currently transformed.", "Yes, yes...", "Once you are done with it, go to the other side."])

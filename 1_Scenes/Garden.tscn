[node name="DialogueArea3" parent="Quests/GardenStunGuard" node_paths=PackedStringArray("cameraFocuses", "questRef") instance=ExtResource("6_3ktbq")]
position = Vector2(1024, -2560)
dialogueText = Array[String](["Nice job, you grabbed a key!", "What's that for, master?", "You see, young-un, to enter the mansion you will need to collect 3 keys, you have just gotten one.", "Sooo... two more to go!", "Indeed, you have completed the review of your training, use what you learned to get the other two keys.", "Also, from what I know, inside the mansion is full of keys to find to proceed, so view this as a proper training area before venturing inside.", "It's quite more crowded inside, after all.", "I am going to impress you master!", "Well, good luck Daichi.", "Thank you master!", "If you wanna review your skills, some of your tanuki friends are here in the area before, to explain the basics again.", "I shall be going now."])
characterTalking = Array[int]([2, 0, 2, 0, 2, 2, 2, 0, 2, 0, 2, 2])

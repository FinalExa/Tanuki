[node name="DialogueArea4" parent="Quests/GardenStunGuard/SwordTanukiNPC" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("6_3ktbq")]
dialogueText = Array[String](["Oh, it's the leaf master, did master manage to recruit such an authority in leafmanship as you?", "...", "...", "...", "Silent, are you? I suppose you are here to explain the leaf...", "...", "...I can attack with my leaf by pressing LEFT CLICK while not transformed...", "...thanks to my Tanuki senses, I can see certain areas which are \"windy with leaves\", if I hit those areas, something will happen...", "...and if I attack one of my foes with the leaf, it will repel them away!", "...is that right?", "...", "...", "*nods*", "...thanks, leaf master!", "(What a weird guy...)"])
characterTalking = Array[int]([0, 2, 0, 2, 0, 2, 0, 0, 0, 0, 2, 0, 2, 0, 0])

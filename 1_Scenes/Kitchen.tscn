[node name="RatDialogue1" parent="Quests/KitchenFeedRat" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("26_b0qex")]
position = Vector2(2368, -1279)
dialogueText = Array[String](["Hey you! You look like someone who is lost… let’s make a deal: if you bring me some food I will give you in return this splendid key that I stole from one of the guards.", "And since I’m a kind soul, maybe I can even tell you a secret that you don’t know about this place.", "Fine, you are lucky that I need that key."])
characterTalking = Array[int]([2, 2, 0])
characterEmotion = Array[int]([0, 0, 0])
cameraFocuses = [NodePath("../Rat"), NodePath("../Rat"), null]
isOnInteraction = true


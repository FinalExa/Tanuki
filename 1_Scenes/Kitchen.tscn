[node name="RatDialogue2" parent="Quests/KitchenFeedRat" node_paths=PackedStringArray("cameraFocuses", "questRef") instance=ExtResource("26_b0qex")]
position = Vector2(2368, -1279)
dialogueText = Array[String](["Oh oh oh, nice. *munch munch munch*", "What a nice meal I had… here’s your key.", "What about the secret?", "Oh, right. If you don’t know… you can reach the roof by watering one of the plants around here.", "Really? Uh, this is actually useful. Thanks, lazy rat."])

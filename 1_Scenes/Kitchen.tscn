dialogueText = Array[String](["There you are! This room feels safe enough... well, I believe I can help you with the chef here.", "Are you serious?", "Indeed I am. If I remember correctly, he needs heat to perform his magic, heat which I provide! Hehehehe...", "That's interesting... I'll be back soon..."])

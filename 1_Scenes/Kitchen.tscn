[node name="StartDialogue" parent="Quests/KitchenHelpChef" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("26_b0qex")]
position = Vector2(-1152, -1112)
dialogueText = Array[String](["Help me please!", "Huh... you look like you've been captured.", "Yes... I had the audacity to disagree with Gozo the other day... and I ended up here.", "I was the Chef of this mansion! This is so unfair.", "I am kind in a hurry... if you have anything that gets me a key I'll help you, though.", "A key? YES! But please, CUT these ropes down first, so we can talk properly.", "Okay. I'll try to find a way to cut the ropes.", "Thank you!"])
characterTalking = Array[int]([2, 0, 2, 2, 0, 2, 0, 2])
cameraFocuses = [NodePath("../ChefYokaiTrapped"), null, NodePath("../ChefYokaiTrapped"), NodePath("../ChefYokaiTrapped"), null, NodePath("../ChefYokaiTrapped"), null, NodePath("../ChefYokaiTrapped")]
isOnInteraction = true

[node name="CollisionShape2D" type="CollisionShape2D" parent="Quests/KitchenHelpChef/StartDialogue"]
shape = SubResource("CircleShape2D_1yhwf")

[node name="MidDialogue" parent="Quests/KitchenHelpChef" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("26_b0qex")]
position = Vector2(-1152, -1112)
dialogueText = Array[String](["Alright, I freed you. Where's my key?", "Yes, about that. I locked it away from the guards here with my food magic!", "Food magic?", "Yes, to reach it I'll need two ingredients, one of which is hot.", "I believe you can read exactly what ingredients I want.", "Indeed I do. I have to bring them to you, yes?", "Yes, and about the hot one... you'll need an heat source of some kind to get it.", "And when you heat them up... you'll have to be fast otherwise they'll turn cold again!", "I got you. Will be back for my key!"])
characterTalking = Array[int]([0, 2, 0, 2, 2, 0, 2, 2, 0])
cameraFocuses = [null, NodePath("../ChefYokai"), null, NodePath("../ChefYokai"), NodePath("../ChefYokai"), null, NodePath("../ChefYokai"), NodePath("../ChefYokai"), null]
isOnInteraction = true

[node name="CollisionShape2D" type="CollisionShape2D" parent="Quests/KitchenHelpChef/MidDialogue"]
shape = SubResource("CircleShape2D_qgs8e")

[node name="EndDialogue" parent="Quests/KitchenHelpChef" node_paths=PackedStringArray("cameraFocuses") instance=ExtResource("26_b0qex")]
position = Vector2(-1152, -1112)
dialogueText = Array[String](["Thanks again for everything!", "No problem. Do you have any advice for me?", "Hm... I believe you are searching for special keys, yes?", "I am, continue.", "Well... I saw the magical space for this one, you'll see there are two rooms. Be fast in the first room, and patient in the second.", "That's a great help, thank you!"])
characterTalking = Array[int]([2, 0, 2, 0, 2, 0])
cameraFocuses = [NodePath("../ChefYokai"), null, NodePath("../ChefYokai"), null, NodePath("../ChefYokai"), null]

position = Vector2(2368, -1279)
dialogueText = Array[String](["Oh oh oh, nice. *munch munch munch*", "What a nice meal I had… here’s your key.", "What about the secret?", "Oh, right. If you didn't know about it, some plants around here grow very tall and fast when they are watered.", "Really? Uh, this is actually useful. Thanks, lazy rat."])
